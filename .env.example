# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# None of these use the NEXT_PUBLIC_ prefix, so Next.js never bundles them into client JS.

# --- Database (docker compose up -d) ---
DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory"
TEST_DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory_test"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console → OAuth client (Web). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only for production mode (`npm run build && npm start`). `npm run dev` trusts localhost
# automatically. In production, Auth.js rejects requests (UntrustedHost) unless told the Host
# header can be trusted.
# AUTH_TRUST_HOST=true
# Behind a hosting proxy (e.g. Railway), also set the public URL. Otherwise Auth.js may build
# OAuth callback URLs from the container's internal address (we saw https://localhost:8080).
# AUTH_URL="https://your-app.example.com"

# --- OpenAI (server-side only) ---
OPENAI_API_KEY=""
# Optional; a small, cheap chat model is used if unset.
OPENAI_MODEL=""
