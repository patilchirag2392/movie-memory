{
  "name": "movie-memory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:retry": "for i in 1 2 3 4 5 6; do prisma migrate deploy && exit 0; echo \"Database not reachable yet (attempt $i/6, it may be waking from sleep); retrying in 5s\"; sleep 5; done; exit 1",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
